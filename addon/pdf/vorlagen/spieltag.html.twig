{# PDF-Addon fuer den Liga Manager Online

  SPDX-License-Identifier: GPL-3.0-or-later

  Das Spieltagsblatt (Lmo\Addon\Pdf\Spieltagsblatt): Spieltag, Tabelle, folgender Spieltag.
-#}
{% import _self as m %}
<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<title>{{ name }} - {{ st }}. {{ text[2] }}</title>
<style>
  @page { margin: 18mm 15mm 16mm 15mm; }
  body { font-family: "DejaVu Sans", sans-serif; font-size: 9pt; color: #000; }
  header { position: fixed; top: -12mm; left: 0; right: 0; font-size: 7pt; color: #555; text-align: right; }
  footer { position: fixed; bottom: -10mm; left: 0; right: 0; font-size: 7pt; color: #555; text-align: center; }
  h1 { font-size: 15pt; margin: 0 0 4mm 0; }
  table { width: 100%; border-collapse: collapse; margin: 0 0 5mm 0; }
  caption { font-weight: bold; font-size: 10pt; text-align: left; padding: 0 0 1.5mm 0; }
  th { border-bottom: 1px solid #000; padding: 1mm 1.5mm; text-align: left; }
  td { padding: 0.8mm 1.5mm; border-bottom: 0.5px solid #ccc; }
  .zahl, th.zahl { text-align: right; }
  .mitte, th.mitte { text-align: center; }
  .hinweis { font-size: 7.5pt; text-align: center; margin: -3mm 0 5mm 0; }
  .ende { font-weight: bold; text-align: center; }
</style>
</head>
<body>
<header>{{ jetzt }} {{ t[103] }}</header>
<footer>{{ homepage }}</footer>
<h1>{{ name }}</h1>
{% if zeigen.spieltag %}
{{ m.spiele(spiele, st ~ '. ' ~ text[2], text, t) }}
{% endif %}
{% if zeigen.tabelle %}
<table>
  <caption>{{ text[16] }} - {{ st }}. {{ text[2] }}</caption>
  <tr>
    <th class="zahl">{{ text[577] }}</th>
    <th>{{ text[281] }}</th>
    <th class="zahl">{{ text[63] }}</th>
    <th class="zahl">{{ text[34] }}</th>
    <th class="zahl">{{ text[35] }}</th>
    <th class="zahl">{{ text[36] }}</th>
    <th class="mitte">{{ text[38] }}</th>
    <th class="zahl">{{ text[39] }}</th>
    <th class="zahl">{{ text[37] }}</th>
  </tr>
{% for z in tabelle %}
  <tr>
    <td class="zahl">{{ z.platz }}</td>
    <td>{{ z.name }}</td>
    <td class="zahl">{{ z.spiele }}</td>
    <td class="zahl">{{ z.siege }}</td>
    <td class="zahl">{{ z.unentschieden }}</td>
    <td class="zahl">{{ z.niederlagen }}</td>
    <td class="mitte">{{ z.tore }}:{{ z.gegentore }}</td>
    <td class="zahl">{{ z.differenz > 0 ? '+' ~ z.differenz : z.differenz }}</td>
    <td class="zahl">{{ z.punkte }}</td>
  </tr>
{% endfor %}
</table>
<p class="hinweis">{{ text[576] }}</p>
{% endif %}
{% if zeigen.folge %}
{% if folge %}
{{ m.spiele(folge.spiele, folge.st ~ '. ' ~ text[2], text, t) }}
{% else %}
<p class="ende">{{ text[568] }}</p>
{% endif %}
{% endif %}
</body>
</html>
{% macro spiele(spiele, titel, text, t) %}
<table>
  <caption>{{ titel }}</caption>
  <tr>
    <th>{{ t[8] }}</th>
    <th>{{ text[549] }}</th>
    <th class="zahl">{{ text[41] }}</th>
    <th></th>
    <th>{{ t[6] }}</th>
    <th class="mitte">{{ t[9] }}</th>
  </tr>
{% for s in spiele %}
  <tr>
    <td>{{ s.datum }}</td>
    <td>{{ s.zeit }}</td>
    <td class="zahl">{{ s.heim }}</td>
    <td class="mitte">-</td>
    <td>{{ s.gast }}</td>
    <td class="mitte">{{ s.ergebnis }}</td>
  </tr>
{% endfor %}
</table>
{% endmacro %}
